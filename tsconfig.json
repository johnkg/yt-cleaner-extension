{
  // Type-checking only — this project has NO build step. The extension
  // loads the .js files directly. Run `npm run typecheck` to have
  // TypeScript verify the JSDoc types without emitting anything.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["chrome"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["app.js", "background.js", "config.js"],
  "exclude": ["node_modules"]
}
